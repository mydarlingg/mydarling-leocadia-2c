<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Semáforo de Ruído</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #121214;
      color: #e1e1e6;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }

    h1 {
      margin-bottom: 8px;
      font-size: 2rem;
      text-align: center;
    }

    p.subtitulo {
      color: #a8a8b3;
      margin-bottom: 25px;
      font-size: 0.95rem;
      text-align: center;
    }

    /* Estrutura do Semáforo */
    .semaforo {
      background-color: #202024;
      padding: 24px;
      border-radius: 30px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), inset 0 0 10px rgba(255, 255, 255, 0.05);
      border: 3px solid #323238;
      width: 150px;
      align-items: center;
    }

    /* Estilo genérico das Luzes */
    .luz {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background-color: #121214;
      border: 4px solid #29292e;
      transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
      opacity: 0.3;
    }

    /* Cores quando ativas */
    .luz.vermelho.ativo {
      background-color: #ff3b30;
      box-shadow: 0 0 35px #ff3b30, inset 0 0 15px #fff;
      opacity: 1;
      transform: scale(1.05);
      animation: pulsar 0.8s infinite alternate;
    }

    .luz.amarelo.ativo {
      background-color: #ffcc00;
      box-shadow: 0 0 35px #ffcc00, inset 0 0 15px #fff;
      opacity: 1;
      transform: scale(1.05);
    }

    .luz.verde.ativo {
      background-color: #34c759;
      box-shadow: 0 0 35px #34c759, inset 0 0 15px #fff;
      opacity: 1;
      transform: scale(1.05);
    }

    @keyframes pulsar {
      from { transform: scale(1.05); }
      to { transform: scale(1.12); }
    }

    /* Painel de Controles e Medidor */
    .painel {
      margin-top: 25px;
      background-color: #202024;
      border: 1px solid #323238;
      padding: 20px;
      border-radius: 16px;
      width: 100%;
      max-width: 360px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    button {
      width: 100%;
      padding: 14px;
      font-size: 1rem;
      font-weight: bold;
      color: #fff;
      background-color: #00875f;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    button:hover {
      background-color: #00b37e;
    }

    .medidor-container {
      width: 100%;
      background-color: #121214;
      border-radius: 10px;
      height: 20px;
      overflow: hidden;
      border: 1px solid #323238;
    }

    .barra-progresso {
      height: 100%;
      width: 0%;
      background-color: #34c759;
      transition: width 0.1s linear, background-color 0.2s ease;
    }

    .info-volume {
      font-size: 1.2rem;
      font-weight: bold;
    }

    .legenda {
      width: 100%;
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: #8d8d99;
    }
  </style>
</head>
<body>

  <h1>Semáforo de Ruído</h1>
  <p class="subtitulo">Monitoramento de áudio em tempo real</p>

  <!-- Estrutura do Semáforo -->
  <div class="semaforo">
    <div id="luz-vermelho" class="luz vermelho"></div>
    <div id="luz-amarelo" class="luz amarelo"></div>
    <div id="luz-verde" class="luz verde"></div>
  </div>

  <!-- Painel de Leitura -->
  <div class="painel">
    <button id="btn-iniciar">🎙️ Ativar Microfone</button>

    <div class="info-volume">
      Volume: <span id="texto-porcentagem">0%</span>
    </div>

    <div class="medidor-container">
      <div id="barra-progresso" class="barra-progresso"></div>
    </div>

    <div class="legenda">
      <span>🟢 0% - 30%</span>
      <span>🟡 30% - 60%</span>
      <span>🔴 > 60%</span>
    </div>
  </div>

  <script>
    const btnIniciar = document.getElementById('btn-iniciar');
    const textoPorcentagem = document.getElementById('texto-porcentagem');
    const barraProgresso = document.getElementById('barra-progresso');

    const luzVerde = document.getElementById('luz-verde');
    const luzAmarelo = document.getElementById('luz-amarelo');
    const luzVermelho = document.getElementById('luz-vermelho');

    let audioContext;
    let analyser;
    let microphone;
    let javascriptNode;

    btnIniciar.addEventListener('click', async () => {
      try {
        // Solicita permissão para acessar o microfone
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });

        btnIniciar.innerText = "🎤 Microfone Ativo";
        btnIniciar.style.backgroundColor = "#29292e";
        btnIniciar.disabled = true;

        // Configuração da Web Audio API
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioContext.createAnalyser();
        microphone = audioContext.createMediaStreamSource(stream);
        javascriptNode = audioContext.createScriptProcessor(2048, 1, 1);

        analyser.smoothingTimeConstant = 0.8;
        analyser.fftSize = 1024;

        microphone.connect(analyser);
        analyser.connect(javascriptNode);
        javascriptNode.connect(audioContext.destination);

        // Processa o nível de ruído em tempo real
        javascriptNode.onaudioprocess = () => {
          const array = new Uint8Array(analyser.frequencyBinCount);
          analyser.getByteFrequencyData(array);

          let valores = 0;
          for (let i = 0; i < array.length; i++) {
            valores += array[i];
          }

          // Média e conversão para porcentagem (0% a 100%)
          const media = valores / array.length;
          let porcentagem = Math.round((media / 128) * 100);

          // Limita a porcentagem entre 0 e 100
          porcentagem = Math.min(100, Math.max(0, porcentagem));

          atualizarSemaforo(porcentagem);
        };

      } catch (err) {
        alert("Erro ao acessar o microfone: " + err.message);
      }
    });

    function atualizarSemaforo(porcentagem) {
      // Atualiza texto e barra
      textoPorcentagem.innerText = porcentagem + "%";
      barraProgresso.style.width = porcentagem + "%";

      // Reseta o estado dos leds
      luzVerde.classList.remove('ativo');
      luzAmarelo.classList.remove('ativo');
      luzVermelho.classList.remove('ativo');

      // Lógica de acendimento com base na sua regra:
      // Verde: 0% até 30%
      // Amarelo: >30% até 60%
      // Vermelho: >60%
      if (porcentagem <= 30) {
        luzVerde.classList.add('ativo');
        barraProgresso.style.backgroundColor = "#34c759";
      } else if (porcentagem > 30 && porcentagem <= 60) {
        luzAmarelo.classList.add('ativo');
        barraProgresso.style.backgroundColor = "#ffcc00";
      } else {
        luzVermelho.classList.add('ativo');
        barraProgresso.style.backgroundColor = "#ff3b30";
      }
    }
  </script>
</body>
</html>
